{
  "manifest_version": 3,
  "name": "AVI Shopper",
  "version": "1.0.0",
  "description": "AVI agrega productos al carrito de supermercados chilenos automaticamente",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://super.lider.cl/*",
    "https://www.jumbo.cl/*",
    "https://www.unimarc.cl/*",
    "https://www.tottus.cl/*",
    "https://www.santaisabel.cl/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://super.lider.cl/*",
        "https://www.jumbo.cl/*",
        "https://www.unimarc.cl/*",
        "https://www.tottus.cl/*",
        "https://www.santaisabel.cl/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AVI Shopper"
  }
}
