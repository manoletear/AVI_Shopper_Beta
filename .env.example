# ============================================
# AVI Shopper — Variables de Entorno
# ============================================

# Database
# Dev (SQLite) — cambiar provider a "sqlite" en prisma/schema.prisma:
# DATABASE_URL="file:./dev.db"
# Produccion (PostgreSQL + schema avi_shopper en soc-chile):
# DATABASE_URL="postgresql://postgres:TU-PASSWORD@db.xksvgacrejsraqjpqsml.supabase.co:5432/postgres?schema=avi_shopper"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # Generar con: openssl rand -base64 32

# App
NODE_ENV="development"

# Anthropic (opcional, para agentes)
# ANTHROPIC_API_KEY="sk-ant-..."

# Cron de reposición (Vercel lo manda como Authorization: Bearer)
# CRON_SECRET=""

# Apify (precios reales de supermercados)
# APIFY_API_TOKEN="apify_api_..."

# Navegador en la nube para abrir el carrito (Hyperbrowser, plan gratis)
# Crear la clave en https://www.hyperbrowser.ai
# HYPERBROWSER_API_KEY=""
# BROWSER_AGENT_KEY=""          # alias aceptado
# BROWSER_AGENT_URL="https://api.hyperbrowser.ai"
# BROWSER_AGENT_PROVIDER="hyperbrowser"   # hyperbrowser | off
# HYPERBROWSER_LLM="gpt-4o-mini"
# HYPERBROWSER_STEALTH="1"
# HYPERBROWSER_PROXY_COUNTRY=""  # ej. CL, solo si tu plan lo incluye

# Jumbo: la clave del carrito es pública (está en el sitio). Cámbiala solo si Jumbo la rota.
# JUMBO_CART_API_URL="https://be-reg-groceries-bff-jumbo.ecomm.cencosud.com"
# JUMBO_CART_API_KEY=""
# JUMBO_SELLER_ID="jumboclj512"

# TypeSafe (decisiones inteligentes)
# TYPESAFE_API_KEY="ts_..."

# Flow.cl (pasarela de pagos)
# FLOW_API_KEY="tu-api-key-de-flow"
# FLOW_SECRET_KEY="tu-secret-key-de-flow"
# FLOW_ENV="sandbox"  # "sandbox" o "production"

# Encryption (para credenciales de supermercados)
# ENCRYPTION_KEY=""  # Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# WhatsApp (numero para link en la app)
# NEXT_PUBLIC_WHATSAPP_NUMBER="56912345678"

# WhatsApp Cloud API (Meta)
# WHATSAPP_TOKEN="EAAxxxxxxx"           # Token de acceso de la app Meta
# WHATSAPP_PHONE_ID="123456789"         # ID del numero de telefono
# WHATSAPP_VERIFY_TOKEN="avi-webhook"   # Token de verificacion del webhook
