// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// MODELS - AVI SHOPPER BACKEND
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  image         String?
  // Puente opcional a Supabase Auth. La app entra con NextAuth y no lo llena.
  // Las políticas de RLS de public usan este valor contra auth.uid().
  authUserId    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  shoppingLists ShoppingList[]
  consents      UserConsent?
  preferences   UserPreference?
  orders        Order[]
  budgets       Budget[]
  alerts        Alert[]
  nutritionData NutritionData[]
  storeAccounts StoreAccount[]
  purchaseHistory PurchaseHistory[]
  familyMembers FamilyMember[]

  @@map("users")
}

model UserConsent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  precios   Boolean  @default(true)
  consumo   Boolean  @default(true)
  salud     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_consents")
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dietType  String?  // vegetarian, vegan, keto, etc.
  allergies String?  // JSON array of allergens
  favorites String?  // JSON array of favorite product IDs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model ShoppingList {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String   @default("Mi lista")
  items     ShoppingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shopping_lists")
}

model ShoppingItem {
  id             String       @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])

  name           String
  quantity       Int          @default(1)
  urgent         Boolean      @default(false)
  checked        Boolean      @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("shopping_items")
}

model Product {
  id          String   @id @default(cuid())

  name        String
  description String?
  category    String
  brand       String?
  barcode     String?  @unique
  imageUrl    String?

  // Nutrition info
  calories    Float?
  protein     Float?
  carbs       Float?
  fat         Float?
  fiber       Float?
  sugar       Float?
  sodium      Float?

  // Classification
  isUltraProcessed Boolean @default(false)
  nutritionScore   Int?    // 0-100

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  prices      ProductPrice[]
  items       ShoppingItem[]

  @@map("products")
}

model Store {
  id          String   @id @default(cuid())

  name        String
  slug        String   @unique
  address     String?
  latitude    Float?
  longitude   Float?
  imageUrl    String?

  // Delivery info
  deliveryFee Int      // in CLP cents
  minOrder    Int?     // in CLP cents

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  prices        ProductPrice[]
  orders        Order[]
  storeAccounts StoreAccount[]

  @@map("stores")
}

model ProductPrice {
  id        String   @id @default(cuid())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  price     Int      // in CLP cents
  stock     Int      @default(0)
  inStock   Boolean  @default(true)

  validFrom DateTime @default(now())
  validTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, storeId])
  @@map("product_prices")
}

model Order {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])

  status    String   // pending, confirmed, in_delivery, delivered, cancelled

  items     String   // JSON array of items

  subtotal  Int      // in CLP cents
  delivery  Int      // in CLP cents
  total     Int      // in CLP cents

  // Delivery info
  eta       DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model Budget {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  period    String   // weekly, monthly
  amount    Int      // in CLP cents
  spent     Int      @default(0)

  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budgets")
}

model Alert {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // budget, stock, savings, nutrition
  title     String
  message   String
  level     String   // info, warn, good

  read      Boolean  @default(false)
  dismissed Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("alerts")
}

model NutritionData {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      DateTime

  // Daily stats
  score          Int    // 0-100
  ultraProcessed Float  // percentage
  fruits         Int    // servings
  protein        Float  // grams
  calories       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("nutrition_data")
}

model ShortcutTemplate {
  id        String   @id @default(cuid())

  name      String   // "Asado", "Cumple", "Desayunos", etc.
  slug      String   @unique
  items     String   // JSON array of items

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shortcut_templates")
}

model StoreAccount {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  accountEmail       String
  accountPassword    String?  // AES-256-GCM encrypted
  accountName        String?
  accountPhone       String?
  loyaltyNumber      String?
  isVerified      Boolean  @default(false)
  isAutoCreated   Boolean  @default(false) // true si AVI creó la cuenta automáticamente

  status    String   @default("active") // active, pending, suspended

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storeId])
  @@map("store_accounts")
}

model PriceObservation {
  id          String   @id @default(cuid())

  productName String
  brand       String?
  storeSlug   String
  storeName   String
  price       Int
  listPrice   Int?
  inStock     Boolean  @default(true)
  url         String?
  imageUrl    String?
  searchTerm  String?

  observedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([productName, storeSlug])
  @@index([storeSlug, observedAt(sort: Desc)])
  @@index([searchTerm, observedAt(sort: Desc)])
  @@map("price_observations")
}

model PurchaseHistory {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productName String
  brand       String?
  category    String?
  storeSlug   String?
  storeName   String?
  price       Int?
  quantity    Int      @default(1)
  unit        String?
  source      String   @default("manual")

  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, purchasedAt(sort: Desc)])
  @@index([userId, productName])
  @@map("purchase_history")
}

model Family {
  id         String   @id @default(cuid())
  name       String   @default("Mi Familia")
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members    FamilyMember[]
  events     FamilyEvent[]

  @@map("families")
}

model FamilyMember {
  id          String   @id @default(cuid())

  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  name        String
  role        String   @default("adult")   // master, adult, child, elder
  type        String   @default("person")  // person, pet
  avatar      String?
  allergies   String?  // JSON array
  dietType    String?
  dateOfBirth String?
  species     String?  // para mascotas: perro, gato, etc
  breed       String?  // raza
  notes       String?
  isActive    Boolean  @default(true)
  events      FamilyEvent[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model FamilyEvent {
  id          String   @id @default(cuid())

  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  memberId    String?
  member      FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  type        String   // national_holiday, religious, cultural, family, seasonal, recurring
  name        String
  month       Int?     // 1-12 for annual events
  day         Int?     // 1-31 for annual events
  isAnnual    Boolean  @default(true)
  remindDays  Int      @default(7)

  suggestedProducts String?  // JSON array
  budgetEstimate    Int?
  notes       String?
  isActive    Boolean  @default(true)
  lastNotified DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([familyId, month, day])
  @@map("family_events")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String?
  source    String   @default("landing")
  createdAt DateTime @default(now())

  @@map("leads")
}

// Catálogo unificado. Una ficha de Jumbo, Lider, Unimarc, Tottus o Santa Isabel
// apunta a un solo producto. En soc-chile se crea con supabase/migrations, no con db push.

model CanonicalProduct {
  id           String   @id @default(cuid())
  name         String
  brand        String?
  category     String
  variant      String?
  sizeAmount   Float?
  sizeUnit     String?
  packCount    Int      @default(1)
  soldByWeight Boolean  @default(false)
  minPurchase  Float?
  stepAmount   Float?
  ean          String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings     StoreListing[]
  reviews      CatalogReview[]
  substitutesFrom ProductSubstitute[] @relation("SubstituteFrom")
  substitutesTo   ProductSubstitute[] @relation("SubstituteTo")

  @@index([category, variant])
  @@index([brand])
  @@map("canonical_products")
}

model StoreListing {
  id              String   @id @default(cuid())
  storeSlug       String
  storeName       String
  rawName         String
  ean             String?
  price           Int?
  inStock         Boolean  @default(true)
  url             String?
  brand           String?
  category        String?
  variant         String?
  sizeAmount      Float?
  sizeUnit        String?
  packCount       Int?
  soldByWeight    Boolean  @default(false)
  canonicalId     String?
  canonical       CanonicalProduct? @relation(fields: [canonicalId], references: [id], onDelete: SetNull)
  matchMethod     String?
  matchConfidence Float?
  matchStatus     String   @default("unmatched")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reviews         CatalogReview[]

  @@index([storeSlug, rawName])
  @@index([ean])
  @@index([matchStatus])
  @@index([canonicalId])
  @@map("store_listings")
}

model CatalogReview {
  id           String   @id @default(cuid())
  listingId    String
  listing      StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  suggestedId  String?
  suggested    CanonicalProduct? @relation(fields: [suggestedId], references: [id], onDelete: SetNull)
  confidence   Float
  reason       String
  status       String   @default("pending")
  resolverNote String?
  resolvedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@map("catalog_reviews")
}

model ProductSubstitute {
  id        String   @id @default(cuid())
  fromId    String
  from      CanonicalProduct @relation("SubstituteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        CanonicalProduct @relation("SubstituteTo", fields: [toId], references: [id], onDelete: Cascade)
  reason    String
  note      String?
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@map("product_substitutes")
}
