// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// MODELS - AVI SHOPPER BACKEND
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  image         String?
  // Puente opcional a Supabase Auth. La app entra con NextAuth y no lo llena.
  // Las políticas de RLS de public usan este valor contra auth.uid().
  authUserId    String?   @unique
  // True hasta que el hogar termina el onboarding (aunque salte pasos).
  // Los usuarios que ya existían quedan en false y entran al inicio.
  householdOnboarding Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  shoppingLists ShoppingList[]
  consents      UserConsent?
  preferences   UserPreference?
  orders        Order[]
  budgets       Budget[]
  alerts        Alert[]
  nutritionData NutritionData[]
  storeAccounts StoreAccount[]
  purchaseHistory PurchaseHistory[]
  familyMembers FamilyMember[]

  @@map("users")
}

model UserConsent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  precios   Boolean  @default(true)
  consumo   Boolean  @default(true)
  salud     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_consents")
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dietType  String?  // vegetarian, vegan, keto, etc.
  allergies String?  // JSON array of allergens
  favorites String?  // JSON array of favorite product IDs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model ShoppingList {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String   @default("Mi lista")
  items     ShoppingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shopping_lists")
}

model ShoppingItem {
  id             String       @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])

  name           String
  quantity       Int          @default(1)
  urgent         Boolean      @default(false)
  checked        Boolean      @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("shopping_items")
}

model Product {
  id          String   @id @default(cuid())

  name        String
  description String?
  category    String
  brand       String?
  barcode     String?  @unique
  imageUrl    String?

  // Nutrition info
  calories    Float?
  protein     Float?
  carbs       Float?
  fat         Float?
  fiber       Float?
  sugar       Float?
  sodium      Float?

  // Classification
  isUltraProcessed Boolean @default(false)
  nutritionScore   Int?    // 0-100

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  prices      ProductPrice[]
  items       ShoppingItem[]

  @@map("products")
}

model Store {
  id          String   @id @default(cuid())

  name        String
  slug        String   @unique
  address     String?
  latitude    Float?
  longitude   Float?
  imageUrl    String?

  // Delivery info
  deliveryFee Int      // in CLP cents
  minOrder    Int?     // in CLP cents

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  prices        ProductPrice[]
  orders        Order[]
  storeAccounts StoreAccount[]

  @@map("stores")
}

model ProductPrice {
  id        String   @id @default(cuid())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  price     Int      // in CLP cents
  stock     Int      @default(0)
  inStock   Boolean  @default(true)

  validFrom DateTime @default(now())
  validTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, storeId])
  @@map("product_prices")
}

model Order {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])

  status    String   // pending, confirmed, in_delivery, delivered, cancelled

  items     String   // JSON array of items

  subtotal  Int      // in CLP cents
  delivery  Int      // in CLP cents
  total     Int      // in CLP cents

  // Delivery info
  eta       DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model Budget {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  period    String   // weekly, monthly
  amount    Int      // in CLP cents
  spent     Int      @default(0)

  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budgets")
}

model Alert {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // budget, stock, savings, nutrition
  title     String
  message   String
  level     String   // info, warn, good

  read      Boolean  @default(false)
  dismissed Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("alerts")
}

model NutritionData {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      DateTime

  // Daily stats
  score          Int    // 0-100
  ultraProcessed Float  // percentage
  fruits         Int    // servings
  protein        Float  // grams
  calories       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("nutrition_data")
}

model ShortcutTemplate {
  id        String   @id @default(cuid())

  name      String   // "Asado", "Cumple", "Desayunos", etc.
  slug      String   @unique
  items     String   // JSON array of items

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shortcut_templates")
}

model StoreAccount {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  accountEmail       String
  accountPassword    String?  // AES-256-GCM encrypted
  accountName        String?
  accountPhone       String?
  loyaltyNumber      String?
  isVerified      Boolean  @default(false)
  isAutoCreated   Boolean  @default(false) // true si AVI creó la cuenta automáticamente

  status    String   @default("active") // active, pending, suspended

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storeId])
  @@map("store_accounts")
}

model PriceObservation {
  id          String   @id @default(cuid())

  productName String
  brand       String?
  storeSlug   String
  storeName   String
  price       Int
  listPrice   Int?
  inStock     Boolean  @default(true)
  url         String?
  imageUrl    String?
  searchTerm  String?

  observedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([productName, storeSlug])
  @@index([storeSlug, observedAt(sort: Desc)])
  @@index([searchTerm, observedAt(sort: Desc)])
  @@map("price_observations")
}

model PurchaseHistory {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  familyId    String?
  family      Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)

  memberId    String?
  member      FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  canonicalProductId String?
  canonicalProduct CanonicalProduct? @relation(fields: [canonicalProductId], references: [id], onDelete: SetNull)

  // Grupo del hogar sin marca, por ejemplo "lacteos|entera".
  groupKey    String?
  orderRef    String?

  productName String
  brand       String?
  category    String?
  storeSlug   String?
  storeName   String?
  price       Int?
  quantity    Float    @default(1)
  unit        String?
  // Cantidad en L, kg o un: paquetes × tamaño × pack del catálogo.
  baseAmount  Float?
  baseUnit    String?
  source      String   @default("manual")

  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  // Se llena cuando esa línea ya actualizó el perfil. No se reprocesa.
  appliedAt   DateTime?

  @@index([userId, purchasedAt(sort: Desc)])
  @@index([userId, productName])
  @@index([familyId, groupKey, purchasedAt])
  @@map("purchase_history")
}

model Family {
  id         String   @id @default(cuid())
  name       String   @default("Mi Familia")
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members    FamilyMember[]
  events     FamilyEvent[]
  purchases  PurchaseHistory[]
  profiles   ConsumptionProfile[]
  replenishmentAlerts ReplenishmentAlert[]
  proposedCarts ProposedCart[]
  addresses  FamilyAddress[]
  stores     FamilyStore[]
  settings   FamilySettings?

  @@map("families")
}

model FamilyMember {
  id          String   @id @default(cuid())

  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  name        String
  role        String   @default("adult")   // master, adult, child, elder
  type        String   @default("person")  // person, pet
  avatar      String?
  allergies   String?  // JSON array
  dietType    String?
  // Dietas múltiples (Instacart Smart Shop). En Postgres es text[].
  dietTags    String[] @default([])
  dateOfBirth String?
  species     String?  // para mascotas: perro, gato, etc
  breed       String?  // raza
  // Columnas vivas en soc-chile (texto, nulas). sex y size van en minúscula;
  // ageRange conserva el camelCase de la tabla. No hace falta @map: el nombre coincide.
  sex         String?
  ageRange    String?
  size        String?
  notes       String?
  isActive    Boolean  @default(true)
  events      FamilyEvent[]
  purchases   PurchaseHistory[]
  preferences MemberPreference[]
  feedback    AlertFeedback[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model FamilyEvent {
  id          String   @id @default(cuid())

  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  memberId    String?
  member      FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  type        String   // national_holiday, religious, cultural, family, seasonal, recurring
  name        String
  month       Int?     // 1-12 for annual events
  day         Int?     // 1-31 for annual events
  isAnnual    Boolean  @default(true)
  remindDays  Int      @default(7)

  suggestedProducts String?  // JSON array
  budgetEstimate    Int?
  notes       String?
  isActive    Boolean  @default(true)
  lastNotified DateTime?
  // Ventana y multiplicador: visitas ×1,5, vacaciones ×0.
  multiplier  Float    @default(1)
  startsAt    DateTime?
  endsAt      DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([familyId, month, day])
  @@map("family_events")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String?
  source    String   @default("landing")
  createdAt DateTime @default(now())

  @@map("leads")
}

// Catálogo unificado. Una ficha de Jumbo, Lider, Unimarc, Tottus o Santa Isabel
// apunta a un solo producto. En soc-chile se crea con supabase/migrations, no con db push.

model CanonicalProduct {
  id           String   @id @default(cuid())
  name         String
  brand        String?
  category     String
  variant      String?
  sizeAmount   Float?
  sizeUnit     String?
  packCount    Int      @default(1)
  soldByWeight Boolean  @default(false)
  minPurchase  Float?
  stepAmount   Float?
  ean          String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings     StoreListing[]
  reviews      CatalogReview[]
  substitutesFrom ProductSubstitute[] @relation("SubstituteFrom")
  substitutesTo   ProductSubstitute[] @relation("SubstituteTo")
  purchases    PurchaseHistory[]
  preferences  MemberPreference[]
  nutrition    ProductNutrition[]

  @@index([category, variant])
  @@index([brand])
  @@map("canonical_products")
}

model StoreListing {
  id              String   @id @default(cuid())
  storeSlug       String
  storeName       String
  rawName         String
  ean             String?
  price           Int?
  inStock         Boolean  @default(true)
  url             String?
  brand           String?
  category        String?
  variant         String?
  sizeAmount      Float?
  sizeUnit        String?
  packCount       Int?
  soldByWeight    Boolean  @default(false)
  canonicalId     String?
  canonical       CanonicalProduct? @relation(fields: [canonicalId], references: [id], onDelete: SetNull)
  matchMethod     String?
  matchConfidence Float?
  matchStatus     String   @default("unmatched")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reviews         CatalogReview[]

  @@index([storeSlug, rawName])
  @@index([ean])
  @@index([matchStatus])
  @@index([canonicalId])
  @@map("store_listings")
}

model CatalogReview {
  id           String   @id @default(cuid())
  listingId    String
  listing      StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  suggestedId  String?
  suggested    CanonicalProduct? @relation(fields: [suggestedId], references: [id], onDelete: SetNull)
  confidence   Float
  reason       String
  status       String   @default("pending")
  resolverNote String?
  resolvedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@map("catalog_reviews")
}

model ProductSubstitute {
  id        String   @id @default(cuid())
  fromId    String
  from      CanonicalProduct @relation("SubstituteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        CanonicalProduct @relation("SubstituteTo", fields: [toId], references: [id], onDelete: Cascade)
  reason    String
  note      String?
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@map("product_substitutes")
}

// Necesidad del hogar sin marca. "lacteos|entera" junta Colun y Soprole.
model ProductGroup {
  id                String   @id @default(cuid())
  familyKey         String   @unique
  category          String
  defaultBaseUnit   String
  priorPerPersonDay Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profiles          ConsumptionProfile[]
  alerts            ReplenishmentAlert[]
  preferences       MemberPreference[]
  cartItems         ProposedCartItem[]

  @@map("product_groups")
}

// Estado del modelo por familia y grupo. Se actualiza de a una compra.
model ConsumptionProfile {
  id              String    @id @default(cuid())
  familyId        String
  family          Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  groupId         String
  group           ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  ratePerDay      Float     @default(0)
  rateVar         Float     @default(0)
  rateMedian      Float     @default(0)
  rateMad         Float     @default(0)
  avgInterval     Float?
  lastPurchaseAt  DateTime?
  lastAmount      Float     @default(0)
  leftover        Float     @default(0)
  estStock        Float     @default(0)
  stockAnchoredAt DateTime?
  runOutAt        DateTime?
  bandEarly       DateTime?
  bandLate        DateTime?
  confidence      String    @default("baja")
  nPurchases      Int       @default(0)
  nIntervals      Int       @default(0)
  seasonFactor    Float     @default(1)
  monthCounts     String?
  frozen          Boolean   @default(false)
  updatedAt       DateTime  @updatedAt

  @@unique([familyId, groupId])
  @@index([familyId, runOutAt])
  @@map("consumption_profiles")
}

model ReplenishmentAlert {
  id              String    @id @default(cuid())
  familyId        String
  family          Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  groupId         String
  group           ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  predictedRunOut DateTime?
  bandEarly       DateTime?
  bandLate        DateTime?
  // open, proposed, approved, dismissed, snoozed
  status          String    @default("open")
  cartId          String?
  cart            ProposedCart? @relation(fields: [cartId], references: [id], onDelete: SetNull)
  message         String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  feedback        AlertFeedback[]

  @@index([familyId, status])
  @@map("replenishment_alerts")
}

model AlertFeedback {
  id            String   @id @default(cuid())
  alertId       String
  alert         ReplenishmentAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  memberId      String?
  member        FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  // ya_tengo, se_acabo_antes, no_compro_mas, cantidad
  kind          String
  stockReported Float?
  createdAt     DateTime @default(now())

  @@index([alertId])
  @@map("alert_feedback")
}

model MemberPreference {
  id                   String   @id @default(cuid())
  memberId             String
  member               FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  groupId              String
  group                ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  preferredCanonicalId String?
  preferredCanonical   CanonicalProduct? @relation(fields: [preferredCanonicalId], references: [id], onDelete: SetNull)
  avoid                Boolean  @default(false)
  notes                String?
  // best_match, specific, none o propose_approve. El hogar también guarda el valor por defecto.
  substitutionMode     String   @default("propose_approve")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([memberId, groupId])
  @@map("member_preferences")
}

// Carro propuesto. La familia lo aprueba. AVI no paga ni hace el pedido.
model ProposedCart {
  id            String   @id @default(cuid())
  familyId      String
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  storeSlug     String
  storeName     String
  // proposed, approved, dismissed
  status        String   @default("proposed")
  subtotal      Int      @default(0)
  delivery      Int      @default(0)
  total         Int      @default(0)
  minOrder      Int      @default(0)
  meetsMinimum  Boolean  @default(false)
  note          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         ProposedCartItem[]
  alerts        ReplenishmentAlert[]

  @@index([familyId, status])
  @@map("proposed_carts")
}

model ProposedCartItem {
  id                 String   @id @default(cuid())
  cartId             String
  cart               ProposedCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  groupId            String?
  group              ProductGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  canonicalProductId String?
  name               String
  quantity           Float
  unit               String
  payable            Int
  runOutAt           DateTime?
  pulledForward      Boolean  @default(false)

  @@index([cartId])
  @@map("proposed_cart_items")
}

// Dirección de despacho del hogar. Una principal.
model FamilyAddress {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  street    String
  number    String   @default("")
  unit      String?
  comuna    String
  // door, handoff, curbside
  dropoff   String   @default("door")
  // casa | casa en condominio | departamento. Columna viva: housingType.
  housingType String?
  notes     String?
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@map("family_addresses")
}

// Tiendas habilitadas, modo de entrega y programa de puntos.
model FamilyStore {
  id             String   @id @default(cuid())
  familyId       String
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  chain          String
  enabled        Boolean  @default(true)
  // delivery o pickup
  mode           String   @default("delivery")
  loyaltyProgram String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([familyId, chain])
  @@index([familyId])
  @@map("family_stores")
}

// Ritmo, presupuesto y decisiones del hogar. Los pasos saltados viven en stepState.
model FamilySettings {
  id                   String   @id @default(cuid())
  familyId             String   @unique
  family               Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  cadence              String?
  deliveryDay          String?
  // Presupuesto por porción, en CLP.
  budget               Int?
  monthlyBudget        Int?
  orderCap             Int?
  // JSON: [{ day, start, end }]
  deliveryWindows      String?
  approverRole         String   @default("master")
  elderWeight          Float    @default(0.8)
  proposeAlcohol       Boolean  @default(true)
  householdSize        Int?
  includesBaby         Boolean  @default(false)
  includesToddler      Boolean  @default(false)
  includesPet          Boolean  @default(false)
  // best_match, specific, none o propose_approve (proponer y que la familia apruebe).
  substitutionMode     String   @default("propose_approve")
  specificReplacements String?
  onboardingStep       String   @default("address")
  stepState            String   @default("{}")
  mandatoryComplete    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("family_settings")
}

// Catálogo de nutrición y alérgenos. La tabla ya existe en soc-chile (public).
// Nombres de columna con @map: la tabla viva es snake_case.
// No correr prisma db push contra soc-chile; el SQL vive en supabase/migrations.
// id es text y lo genera la app (uuid). Los índices únicos parciales de ean y
// store_sku, el gin_trgm y los CHECK están solo en SQL.
model ProductNutrition {
  id                 String   @id @map("id")
  canonicalProductId String?  @map("canonical_product_id")
  ean                String?  @map("ean")
  store              String?  @map("store")
  storeSku           String?  @map("store_sku")
  brand              String?  @map("brand")
  name               String   @map("name")
  format             String?  @map("format")
  ingredientsText    String?  @map("ingredients_text")
  allergens          String[] @default([]) @map("allergens")
  traces             String[] @default([]) @map("traces")
  kcal100g           Float?   @map("kcal_100g") @db.DoublePrecision
  protein100g        Float?   @map("protein_100g") @db.DoublePrecision
  fat100g            Float?   @map("fat_100g") @db.DoublePrecision
  carbs100g          Float?   @map("carbs_100g") @db.DoublePrecision
  sugar100g          Float?   @map("sugar_100g") @db.DoublePrecision
  sodiumMg100g       Float?   @map("sodium_mg_100g") @db.DoublePrecision
  servingSizeG       Float?   @map("serving_size_g") @db.DoublePrecision
  sellosChile        String[] @default([]) @map("sellos_chile")
  source             String   @map("source")
  sourceUrl          String?  @map("source_url")
  sourceDetail       Json     @map("source_detail")
  allergenStatus     String   @default("unverified") @map("allergen_status")
  fetchedAt          DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  canonical CanonicalProduct? @relation(fields: [canonicalProductId], references: [id], onDelete: SetNull)

  @@index([canonicalProductId], map: "product_nutrition_canonical_idx")
  @@index([fetchedAt], map: "product_nutrition_fetched_idx")
  @@map("product_nutrition")
}
