{
  "manifest_version": 3,
  "name": "AVI Shopper — Auto Agregar al Carrito",
  "version": "1.0.0",
  "description": "AVI agrega productos automaticamente al carrito de supermercados chilenos",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://super.lider.cl/*",
    "https://www.jumbo.cl/*",
    "https://www.unimarc.cl/*",
    "https://www.tottus.cl/*",
    "https://www.santaisabel.cl/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://super.lider.cl/ip/*",
        "https://super.lider.cl/search*",
        "https://super.lider.cl/cart*",
        "https://super.lider.cl/checkout*",
        "https://www.jumbo.cl/*/p",
        "https://www.jumbo.cl/search*",
        "https://www.jumbo.cl/checkout*",
        "https://www.jumbo.cl/mi-carro*",
        "https://www.unimarc.cl/product/*",
        "https://www.unimarc.cl/search*",
        "https://www.unimarc.cl/checkout*",
        "https://www.tottus.cl/*",
        "https://www.santaisabel.cl/*/p",
        "https://www.santaisabel.cl/buscar*",
        "https://www.santaisabel.cl/checkout*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
