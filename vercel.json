{
  "buildCommand": "prisma generate && next build",
  "framework": "nextjs",
  "installCommand": "npm ci --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/cron/replenishment",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/carts",
      "schedule": "0 11 * * 1"
    }
  ]
}
